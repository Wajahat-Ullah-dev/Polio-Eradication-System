
@model IEnumerable<PolioEradication.Models.Entities.PolioCase>

@{
    ViewData["Title"] = "Health Worker Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Health Worker Dashboard</h1>
    
    <div class="row">
        <div class="col-xl-6 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">My Reported Cases</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.AssignedCasesCount</span>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">System Pending Requests</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.PendingRequestsCount</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <h3>My Recent Reports</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Patient Name</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DateReported.ToShortDateString()</td>
                            <td>@item.PatientName</td>
                            <td>@item.Location</td>
                            <td>@item.Status</td>
                            <td>
                                <a asp-action="EditCase" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <a asp-action="ReportCase" class="btn btn-primary mt-3">Report New Case</a>
        </div>
    </div>
</div>
