
@model IEnumerable<PolioEradication.Models.Entities.VaccinationSchedule>

@{
    ViewData["Title"] = "Vaccination Schedule";
}

<div class="container-fluid">
    <h1 class="mt-4">Vaccination Schedule</h1>
    <div class="mb-3">
        <a asp-action="CreateSchedule" class="btn btn-primary">Create New Schedule</a>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-calendar-alt me-1"></i>
            Upcoming Campaigns
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Age Group</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Date.ToShortDateString()</td>
                            <td>@item.Location</td>
                            <td>@item.AgeGroup</td>
                            <td>
                                <a asp-action="EditSchedule" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="DeleteSchedule" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
