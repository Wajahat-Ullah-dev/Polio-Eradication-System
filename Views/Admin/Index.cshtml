
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4">Admin Dashboard</h1>
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">Total Users</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.TotalUsers</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">Pending Requests</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.PendingRequests</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">Total Requests</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.TotalRequests</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">Reported Cases</div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="h5">@ViewBag.TotalCases</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-users me-1"></i>
                    Quick Actions
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Users" class="btn btn-outline-primary">Manage Users</a>
                        <a asp-action="Schedule" class="btn btn-outline-secondary">Manage Schedule</a>
                        <a asp-action="Requests" class="btn btn-outline-success">View Requests</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
